<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<fx:root xmlns:fx="http://javafx.com/fxml" type="AnchorPane"
         xmlns="http://javafx.com/javafx/">
    <children>
        <VBox alignment="CENTER_LEFT" layoutX="55.0" spacing="5.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox maxWidth="1.7976931348623157E308" spacing="5.0">
                    <children>
                        <TextField fx:id="tfTexte" onKeyReleased="#action_filtrer" prefWidth="200.0"/>
                        <Button fx:id="btnEffacer" mnemonicParsing="false" onAction="#action_vider_textField" text="x"/>
                    </children>
                </HBox>
                <ComboBox fx:id="combo" maxWidth="1.7976931348623157E308" onHidden="#action_selection_combo"
                          prefWidth="300.0"/>
            </children>
            <padding>
                <Insets bottom="5.0" top="5.0"/>
            </padding>
        </VBox>
    </children>
</fx:root>
