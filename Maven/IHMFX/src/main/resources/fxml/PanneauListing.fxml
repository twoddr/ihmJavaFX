<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml" id="GridPane" prefHeight="800.0" prefWidth="400.0"
          fx:controller="controlsFX.PanneauListingController"
          alignment="CENTER_RIGHT" hgap="10.0" maxHeight="1.7976931348623157E308" maxWidth="400.0" minWidth="350.0"
          vgap="10.0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="120.0" minWidth="60.0" prefWidth="100.0"/>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="120.0" minWidth="60.0" prefWidth="100.0"/>
        <ColumnConstraints hgrow="ALWAYS" maxWidth="120.0" minWidth="60.0" prefWidth="100.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
    </rowConstraints>
    <children>
        <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#action_ajouter" text="Ajouter"/>
        <Button fx:id="btnModifier" mnemonicParsing="false" onAction="#action_modifier" text="Modifier"
                GridPane.columnIndex="1"/>
        <Button fx:id="btnSupprimer" mnemonicParsing="false" onAction="#action_supprimer" text="Supprimer"
                GridPane.columnIndex="2"/>
        <Button fx:id="btnRafraichir" mnemonicParsing="false" text="Rafraichir" GridPane.columnIndex="1"
                GridPane.rowIndex="3"/>
        <TextField fx:id="tfFiltre" promptText="Tapez ici les premières lettres du nom à afficher"
                   GridPane.columnSpan="2147483647" GridPane.rowIndex="1"/>
        <ListView fx:id="listeClients" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                  onMouseReleased="#action_selection_client" prefHeight="400.0" prefWidth="300.0"
                  GridPane.columnSpan="2147483647" GridPane.hgrow="SOMETIMES" GridPane.rowIndex="2"
                  GridPane.vgrow="ALWAYS"/>
    </children>
</GridPane>  

