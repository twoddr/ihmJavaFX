<?xml version="1.0" encoding="UTF-8"?>


<?import controlsFX.ComboFiltrableController?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
            prefWidth="600.0" xmlns="http://javafx.com/javafx/"
            fx:controller="mainIHMFX.SampleController">
    <top>
        <Label text="Test du ComboFiltrable" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
            </padding>
        </Label>
    </top>
    <center>
        <ComboFiltrableController fx:id="comboF" prefWidth="150.0" BorderPane.alignment="CENTER"/>
    </center>
    <bottom>
        <Label text="Commentaires" fx:id="lblCommentaires" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
