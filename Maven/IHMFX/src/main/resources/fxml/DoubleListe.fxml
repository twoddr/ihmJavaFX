<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<fx:root xmlns:fx="http://javafx.com/fxml/1" type="BorderPane" xmlns="http://javafx.com/javafx/">
    <center>
        <GridPane hgap="5.0" prefHeight="150.0" prefWidth="600.0" vgap="5.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="60.0"/>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
            </rowConstraints>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
            <Label fx:id="lblCible" text="Éléments sélectionnés">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
            </Label>
            <Label fx:id="lblSource" text="Éléments disponibles" GridPane.columnIndex="2">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
            </Label>
            <ListView fx:id="listeCible" onMousePressed="#action_clic_listeCible" GridPane.rowIndex="1"
                      GridPane.vgrow="ALWAYS"/>
            <ListView fx:id="listeSource" onMousePressed="#action_clic_listeSource" GridPane.columnIndex="2"
                      GridPane.rowIndex="1" GridPane.vgrow="ALWAYS"/>
            <VBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                  GridPane.rowIndex="1">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <Button fx:id="btnToutVersCible" mnemonicParsing="false" prefWidth="50.0" text="&lt;&lt;"/>
                <Button fx:id="btnVersCible" mnemonicParsing="false" prefWidth="50.0" text="&lt;"/>
                <Button fx:id="btnVersSource" layoutX="10.0" layoutY="36.0" mnemonicParsing="false" prefWidth="50.0"
                        text="&gt;"/>
                <Button fx:id="btnToutVersSource" layoutX="10.0" layoutY="62.0" mnemonicParsing="false" prefWidth="50.0"
                        text="&gt;&gt;"/>
            </VBox>
        </GridPane>
    </center>
</fx:root>
