<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<HBox xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="10.0"
      xmlns="http://javafx.com/javafx/" fx:id="cellule">
    <children>
        <StackPane>
            <children>
                <Rectangle fx:id="rectangle" arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="25.0" stroke="BLACK"
                           strokeType="INSIDE" width="200.0"/>
                <Label fx:id="label" text="Label"/>
            </children>
        </StackPane>
        <ImageView fx:id="imageView" fitHeight="25.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@/images/question.png"/>
            </image>
        </ImageView>
    </children>
    <padding>
        <Insets bottom="2.0" left="5.0" right="2.0" top="2.0"/>
    </padding>
</HBox>
