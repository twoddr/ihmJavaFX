<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<fx:root xmlns:fx="http://javafx.com/fxml" id="logPane" fx:id="FXLog"
         type="BorderPane" xmlns="http://javafx.com/javafx">
    <center>
        <TabPane layoutX="5.0" layoutY="5.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0"
                 AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
            <Tab text="Commentaires">
                <VBox alignment="CENTER" spacing="20.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <Label alignment="CENTER" text="Commentaires de l'application :">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <font>
                            <Font size="18.0"/>
                        </font>
                    </Label>
                    <ScrollPane fitToHeight="true" fitToWidth="true" prefViewportHeight="346.0"
                                prefViewportWidth="677.0" VBox.vgrow="SOMETIMES">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                        <TextArea fx:id="taConsole" VBox.vgrow="SOMETIMES"/>
                    </ScrollPane>
                    <HBox alignment="CENTER" spacing="20.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                        <Button fx:id="btnEnregistrer" mnemonicParsing="false"
                                onAction="#action_enregistrer" text="Enregistrer dans fichier"/>
                        <Button fx:id="btnEffacer" mnemonicParsing="false" onAction="#action_effacer"
                                text="Effacer"/>
                        <Button fx:id="btnRepere" mnemonicParsing="false"
                                onAction="#action_inserer_repere" text="Insérer repère"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Activités réseau">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <center>
                        <TitledPane collapsible="false" maxHeight="1.7976931348623157E308"
                                    maxWidth="1.7976931348623157E308" text="Entrées sorties"
                                    BorderPane.alignment="CENTER">
                            <ListView fx:id="listeIO" onMouseClicked="#action_clic_liste_IO"/>
                        </TitledPane>
                    </center>
                    <right>
                        <TitledPane collapsible="false" maxHeight="1.7976931348623157E308"
                                    maxWidth="1.7976931348623157E308" text="Orphelins"
                                    BorderPane.alignment="CENTER">
                            <ListView fx:id="listeOrphelins" onMouseClicked="#action_clic_liste_orphelins"/>
                        </TitledPane>
                    </right>
                    <bottom>
                        <TitledPane collapsible="false" text="Détails" BorderPane.alignment="CENTER">
                            <TextArea fx:id="taDetailsReseau" wrapText="true"/>
                        </TitledPane>
                    </bottom>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
</fx:root>
