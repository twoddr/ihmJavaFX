<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<fx:root xmlns:fx="http://javafx.com/fxml/1" type="VBox" spacing="5.0" xmlns="http://javafx.com/javafx/">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
    <TextField fx:id="dateTextField" minWidth="90.0" maxWidth="180"/>
    <Label fx:id="validationLabel" text="Aucune date">
        <VBox.margin>
            <Insets/>
        </VBox.margin>
    </Label>
</fx:root>
