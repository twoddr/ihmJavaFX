<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.HBox?>
<fx:root xmlns:fx="http://javafx.com/fxml" alignment="CENTER_LEFT" spacing="5.0"
         type="HBox" xmlns="http://javafx.com/javafx">
    <padding>
        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0"/>
    </padding>

    <!-- ComboBox flexible qui prend tout l'espace disponible -->
    <ComboBox fx:id="combo" editable="true"
              minWidth="150" maxWidth="600" HBox.hgrow="ALWAYS"
              onKeyReleased="#action_filtrer" promptText="Vide !"/>

    <!-- Boutons à taille fixe -->
    <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#action_ajouter"
            prefWidth="30" minWidth="30" maxWidth="30">
        <graphic>
            <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@/images/add.png"/>
            </ImageView>
        </graphic>
    </Button>
    <Button fx:id="btnRafraichir" mnemonicParsing="false" onAction="#action_rafraichir"
            prefWidth="30" minWidth="30" maxWidth="30">
        <graphic>
            <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@/images/refresh.png"/>
            </ImageView>
        </graphic>
    </Button>
    <Button fx:id="btnEffacer" mnemonicParsing="false" onAction="#action_effacer"
            prefWidth="30" minWidth="30" maxWidth="30">
        <graphic>
            <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@/images/sweep.png"/>
            </ImageView>
        </graphic>
    </Button>
</fx:root>
