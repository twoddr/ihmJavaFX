<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<fx:root xmlns:fx="http://javafx.com/fxml" fx:id="ListeFiltrable"
         type="AnchorPane" xmlns="http://javafx.com/javafx/">

    <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0" fx:id="ligneFiltre">
            <VBox.margin>
                <Insets/>
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <Label minWidth="-Infinity" text="Filtre :"/>
                <TextField fx:id="tfFiltre" prefWidth="200.0" promptText="Tapez ici pour filtrer la liste"/>
                <Button fx:id="btnEffacer" mnemonicParsing="false" onAction="#action_vider_textField" text="x"/>
            </children>
        </HBox>
        <ListView fx:id="liste" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </ListView>
    </VBox>
</fx:root>
